// Rendered twice by build.py; the constant removes the backend branch.
import fs from "../..";
import std;
import os;
const CUSTOM = @CUSTOM@;
const ADAPTIVE = @ADAPTIVE@;
fn checksum(bytes: const u8[:]) -> i64 {
    var result = bytes.len;
    if bytes.len > 0 { result += bytes[0]; result += bytes[bytes.len - 1]; }
    return result;
}
fn read_into(path: const u8[:], size: i64, bytes: u8[>..]&) {
    if CUSTOM { assert(fs::read(path, size, bytes).error == fs::Error.None); }
    else { bytes.clear(); assert(read_file(path, bytes)); }
    assert(bytes.len == size);
}
fn check_pattern(bytes: const u8[:]) {
    for c, i in bytes { assert(c == ((i * 17 + 13) % 251) as u8); }
}
fn fresh_read(path: const u8[:], size: i64) -> i64 {
    var bytes: u8[>..] = [];
    read_into(path, size, bytes);
    return checksum(bytes);
}
fn reads(path: const u8[:], size: i64, count: i64, fresh: bool) {
    let label = str(if fresh { "read-fresh-" } else { "read-reuse-" }, size);
    var bytes: u8[>..] = [];
    read_into(path, size, bytes); check_pattern(bytes);
    for sample in 7 {
        var sum: i64 = 0;
        let start = clock_ns();
        if fresh { for _ in count { sum += fresh_read(path, size); } }
        else { for _ in count { read_into(path, size, bytes); sum += checksum(bytes); } }
        let elapsed = clock_ns() - start;
        print(label, "\t", sample, "\t", elapsed / count, "\t", sum, "\tok");
    }
    check_pattern(bytes);
}
fn expected_name(index: i64) -> u8[>..] {
    return str("entry-", index / 1000 % 10, index / 100 % 10, index / 10 % 10, index % 10);
}
fn retained_read(path: const u8[:], size: i64, count: i64) {
    let label = str("read-retained-", size);
    if !CUSTOM {
        for sample in 7 { print(label, "\t", sample, "\t0\t0\tunsupported"); }
        return;
    }
    let context, created = fs::create_context(); assert(created.error == fs::Error.None);
    let file, opened = fs::open_file(context, path, fs::OpenOptions { .. });
    assert(opened.error == fs::Error.None);
    var bytes: u8[>..] = [];
    let warm = fs::read_at(file, 0, size, bytes);
    assert(warm.status.error == fs::Error.None && warm.bytes == size); check_pattern(bytes);
    for sample in 7 {
        var sum: i64 = 0;
        let start = clock_ns();
        for _ in count {
            let result = fs::read_at(file, 0, size, bytes);
            assert(result.status.error == fs::Error.None && result.bytes == size);
            sum += checksum(bytes);
        }
        let elapsed = clock_ns() - start;
        print(label, "\t", sample, "\t", elapsed / count, "\t", sum, "\tok");
    }
    check_pattern(bytes);
    assert(fs::close_context(context).error == fs::Error.None);
}
fn custom_list(path: const u8[:], entries: fs::Entry[>..]&) -> fs::Status {
    if ADAPTIVE { return fs::list_sorted(path, fs::ListOptions { adaptive: true }, entries); }
    return fs::list_sorted(path, fs::MAX_BYTES, fs::MAX_ENTRIES, entries);
}
fn custom_root_list(root: fs::Root, entries: fs::Entry[>..]&) -> fs::Status {
    if ADAPTIVE { return fs::list_sorted_at(root, "list-128", fs::ListOptions { adaptive: true }, entries); }
    return fs::list_sorted_at(root, "list-128", fs::MAX_BYTES, fs::MAX_ENTRIES, entries);
}
fn listing(path: const u8[:], count: i64, iterations: i64) {
    let label = str("list-sorted-", count);
    var entries: fs::Entry[>..] = [];
    var packed: u8[>..] = [];
    if CUSTOM {
        assert(custom_list(path, entries).error == fs::Error.None);
        assert(entries.len == count);
        for entry, i in entries { assert(entry.name == expected_name(i)); }
    } else {
        assert(list_dir(path, packed));
        var start: i64 = 0; var found: i64 = 0;
        for c, i in packed {
            if c == '\n' { assert(packed[start..i] == expected_name(found)); found++; start = i + 1; }
        }
        assert(found == count && start == packed.len);
    }
    for sample in 7 {
        var sum: i64 = 0;
        let start = clock_ns();
        for _ in iterations {
            if CUSTOM {
                assert(custom_list(path, entries).error == fs::Error.None);
                for entry in entries {
                    sum += entry.name.len; sum += entry.name[0]; sum += entry.name[entry.name.len - 1];
                }
            } else {
                packed.clear(); assert(list_dir(path, packed));
                var begin: i64 = 0;
                for c, i in packed {
                    if c == '\n' { sum += i - begin; sum += packed[begin]; sum += packed[i - 1]; begin = i + 1; }
                }
            }
        }
        let elapsed = clock_ns() - start;
        print(label, "\t", sample, "\t", elapsed / iterations, "\t", sum, "\tok");
    }
}
fn metadata_case(path: const u8[:], count: i64) {
    var info = fs::Metadata { .. };
    for sample in 7 {
        if CUSTOM {
            var sum: i64 = 0;
            let start = clock_ns();
            for _ in count {
                assert(fs::metadata(path, info).error == fs::Error.None);
                assert(info.kind == fs::Kind.File && info.size == 64);
                sum += 65;
            }
            let elapsed = clock_ns() - start;
            print("metadata-file\t", sample, "\t", elapsed / count, "\t", sum, "\tok");
        } else { print("metadata-file\t", sample, "\t0\t0\tunsupported"); }
    }
}
fn dir_case(path: const u8[:], count: i64) {
    for sample in 7 {
        var sum: i64 = 0;
        let start = clock_ns();
        for _ in count {
            if CUSTOM { let yes, result = fs::is_dir(path); assert(yes && result.error == fs::Error.None); }
            else { assert(is_dir(path)); }
            sum++;
        }
        let elapsed = clock_ns() - start;
        print("is-dir\t", sample, "\t", elapsed / count, "\t", sum, "\tok");
    }
}
fn locking(path: const u8[:], count: i64) {
    if !CUSTOM {
        for sample in 7 { print("lock-exclusive-pair\t", sample, "\t0\t0\tunsupported"); }
        return;
    }
    let context, created = fs::create_context(); assert(created.error == fs::Error.None);
    let file, opened = fs::open_file(context, path, fs::OpenOptions { .. });
    assert(opened.error == fs::Error.None);
    let warm, warmed = fs::try_lock_file(file, fs::LockMode.Exclusive);
    assert(warm && warmed.error == fs::Error.None);
    assert(fs::unlock_file(file).error == fs::Error.None);
    for sample in 7 {
        var sum: i64 = 0;
        let start = clock_ns();
        for _ in count {
            let acquired, result = fs::try_lock_file(file, fs::LockMode.Exclusive);
            assert(acquired && result.error == fs::Error.None);
            assert(fs::unlock_file(file).error == fs::Error.None);
            sum++;
        }
        let elapsed = clock_ns() - start;
        print("lock-exclusive-pair\t", sample, "\t", elapsed / count, "\t", sum, "\tok");
    }
    assert(fs::close_context(context).error == fs::Error.None);
}
fn root_fresh_read(root: fs::Root) -> i64 {
    var bytes: u8[>..] = [];
    assert(fs::read_file_at(root, "read-64", 64, bytes).error == fs::Error.None && bytes.len == 64);
    return checksum(bytes);
}
fn rooted(path: const u8[:], count: i64) {
    if !CUSTOM {
        for label in ["root-read-fresh-64", "root-metadata-file", "root-list-sorted-128"] {
            for sample in 7 { print(label, "\t", sample, "\t0\t0\tunsupported"); }
        }
        return;
    }
    let context, created = fs::create_context(); assert(created.error == fs::Error.None);
    let root, opened = fs::open_root(context, path); assert(opened.error == fs::Error.None);
    var bytes: u8[>..] = [];
    assert(fs::read_file_at(root, "read-64", 64, bytes).error == fs::Error.None && bytes.len == 64); check_pattern(bytes);
    var info = fs::Metadata { .. };
    assert(fs::metadata_at(root, "read-64", info).error == fs::Error.None && info.size == 64 && info.kind == fs::Kind.File);
    var entries: fs::Entry[>..] = [];
    assert(custom_root_list(root, entries).error == fs::Error.None);
    assert(entries.len == 128); for entry, i in entries { assert(entry.name == expected_name(i)); }
    for operation in 3 {
        let label: const u8[:] = if operation == 0 { "root-read-fresh-64" }
            else if operation == 1 { "root-metadata-file" } else { "root-list-sorted-128" };
        for sample in 7 {
            var sum: i64 = 0;
            let start = clock_ns();
            for _ in count {
                if operation == 0 { sum += root_fresh_read(root); }
                else if operation == 1 {
                    assert(fs::metadata_at(root, "read-64", info).error == fs::Error.None && info.kind == fs::Kind.File && info.size == 64);
                    sum += 65;
                } else {
                    assert(custom_root_list(root, entries).error == fs::Error.None);
                    for entry in entries { sum += entry.name.len; sum += entry.name[0]; sum += entry.name[entry.name.len - 1]; }
                }
            }
            let elapsed = clock_ns() - start;
            print(label, "\t", sample, "\t", elapsed / count, "\t", sum, "\tok");
        }
    }
    assert(fs::close_context(context).error == fs::Error.None);
}
fn rename_one(from: const u8[:], to: const u8[:], root: fs::Root, rooted: bool, options: fs::RenameOptions) {
    if CUSTOM {
        let result = if rooted { fs::rename_at(root, from, to, options) } else { fs::rename(from, to, options) };
        assert(result.status.error == fs::Error.None && result.outcome == fs::RenameOutcome.Applied);
        assert(result.parents_synced == options.sync_parents && result.cleanup_os_error == 0);
    } else { assert(rename_file(from, to)); }
}
fn rename_pair(from: const u8[:], to: const u8[:], root: fs::Root, rooted: bool, options: fs::RenameOptions) {
    rename_one(from, to, root, rooted, options);
    rename_one(to, from, root, rooted, options);
}
fn rename_case(path: const u8[:], count: i64, rooted: bool, mode: i64) {
    let suffix: const u8[:] = if mode == 0 { "rename-replace-pair" } else if mode == 1 { "rename-parents-sync-pair" } else { "rename-noreplace-pair" };
    let label = str(if rooted { "root-" } else { "" }, suffix);
    if !CUSTOM && (rooted || mode != 0) {
        for sample in 7 { print(label, "\t", sample, "\t0\t0\tunsupported"); }
        return;
    }
    let from = str(path, "/left"); let to = str(path, "/right");
    var context = fs::Context { .. }; var root = fs::Root { .. };
    if CUSTOM && rooted {
        let c, ce = fs::create_context(); assert(ce.error == fs::Error.None); context = c;
        let r, re = fs::open_root(context, path); assert(re.error == fs::Error.None); root = r;
    }
    let options = fs::RenameOptions { policy: if mode == 2 { fs::RenamePolicy.NoReplace } else { fs::RenamePolicy.Replace }, sync_parents: mode == 1 };
    var bytes: u8[>..] = []; assert(read_file(from, bytes) && bytes == "rename fixture");
    if CUSTOM { let found, e = fs::exists(to); assert(e.error == fs::Error.None && !found); }
    else { assert(!file_exists(to)); }
    let call_from: const u8[:] = if rooted { "left" } else { from };
    let call_to: const u8[:] = if rooted { "right" } else { to };
    rename_one(call_from, call_to, root, rooted, options);
    bytes.clear(); assert(read_file(to, bytes) && bytes == "rename fixture");
    if CUSTOM { let found, e = fs::exists(from); assert(e.error == fs::Error.None && !found); }
    else { assert(!file_exists(from)); }
    rename_one(call_to, call_from, root, rooted, options);
    rename_pair(call_from, call_to, root, rooted, options);
    for sample in 7 {
        var sum: i64 = 0;
        let start = clock_ns();
        for _ in count { rename_pair(call_from, call_to, root, rooted, options); sum++; }
        let elapsed = clock_ns() - start;
        print(label, "\t", sample, "\t", elapsed / count, "\t", sum, "\tok");
    }
    bytes.clear(); assert(read_file(from, bytes) && bytes == "rename fixture");
    if CUSTOM { let found, e = fs::exists(to); assert(e.error == fs::Error.None && !found); }
    else { assert(!file_exists(to)); }
    if CUSTOM && rooted { assert(fs::close_context(context).error == fs::Error.None); }
}
fn main() {
    let argv = args(); assert(argv.len == 3);
    let count, valid = parse_int(argv[2], 10); assert(valid && count > 0 && count <= 1000000);
    for size in [0, 64, 4096, 65536, 1048576] {
        let path = str(argv[1], "/read-", size);
        reads(path, size, count, true); reads(path, size, count, false);
        retained_read(path, size, count);
    }
    for entries in [0, 1, 128, 4096] {
        let path = str(argv[1], "/list-", entries); listing(path, entries, count);
    }
    let file = str(argv[1], "/read-64"); metadata_case(file, count); locking(file, count);
    let directory = str(argv[1], "/list-0"); dir_case(directory, count);
    rooted(argv[1], count);
    let rename_path = str(argv[1], "/rename");
    for mode in 3 { rename_case(rename_path, count, false, mode); rename_case(rename_path, count, true, mode); }
    var status: u8[>..] = [];
    assert(read_file("/proc/self/status", status));
    var start: i64 = 0;
    for c, i in status {
        if c == '\n' {
            let line: const u8[:] = status[start..i];
            if line.len >= 6 && line[..6] == "VmHWM:" { print("MEMORY\t", line); }
            start = i + 1;
        }
    }
}
